# Copy to .env — or just run ./install.sh, which does this and fills in the secrets.
#
#   cp .env.example .env
#   sed -i "s|^HOUSEHOLD_SECRET=.*|HOUSEHOLD_SECRET=$(openssl rand -hex 32)|" .env
#   sed -i "s|^COOKIE_SECRET=.*|COOKIE_SECRET=$(openssl rand -hex 32)|" .env
#
# .env is git-ignored.

# Whoever knows this value in the invite link may register a device:
#   https://baby.<your-domain>/start?t=<HOUSEHOLD_SECRET>
# Treat it like a house key.
HOUSEHOLD_SECRET=

# Signs the session cookie. Changing it signs out every device.
COOKIE_SECRET=

# Suggested country for check-ups and vaccinations on the setup screen:
# de | at | ch | gb | us | none. Only a suggestion — the binding value is stored
# with the child and can be changed in Settings.
DEFAULT_REGION=none

# debug | info | warn | error
LOG_LEVEL=info

# How long the files of an older release stay on the server. A device that still
# has the app open keeps working until it reloads on its own.
ASSET_KEEP_DAYS=30

# Nightly backups to ./backups
BACKUP_KEEP_DAYS=30

# Web push for the bottle reminder. Without these the section is simply hidden and
# the app works fully otherwise. Generate with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Changing them unsubscribes every device.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
