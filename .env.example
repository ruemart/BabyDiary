# Nach .env kopieren und beide Werte erzeugen:
#
#   openssl rand -hex 32
#
# .env ist über .gitignore ausgeschlossen.

# Wer diesen Wert im Einladungs-Link kennt, darf ein Gerät anmelden.
# Der Link lautet:  https://baby.<deine-domain>/start?t=<HOUSEHOLD_SECRET>
HOUSEHOLD_SECRET=

# Signiert das Sitzungs-Cookie. Ändern meldet alle Geräte ab.
COOKIE_SECRET=

# debug | info | warn | error
LOG_LEVEL=info

# Web Push für die Fläschchen-Erinnerung. Fehlen die Werte, sind Benachrichtigungen
# aus — die App funktioniert vollständig ohne. Erzeugen mit:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Ändern meldet alle Geräte ab.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:du@example.com
